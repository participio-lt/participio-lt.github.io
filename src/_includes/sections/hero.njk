  <header class="hero" id="top">
    <div class="container hero-grid">
      <h1 class="hero-title">{{ t.research_that_listens_before_it | safe }}</h1>
      <svg class="process" viewBox="0 0 1000 470" role="img" aria-label="{{ t.process_label }}">
        <defs>
          <marker id="arrowhead" viewBox="0 0 12 12" refX="9" refY="6" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 2 2 L 10 6 L 2 10" fill="none" stroke="#15121f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </marker>
        </defs>
        <g fill="none" stroke="#15121f" stroke-width="2.2" stroke-linecap="round" marker-end="url(#arrowhead)">
          <path d="M 248 114 Q 269 101 290 112"/>
          <path d="M 518 110 Q 531 98 544 110"/>
          <path d="M 767 188 Q 784 189 785 206"/>
          <path d="M 773 322 Q 758 339 736 333"/>
          <path d="M 486 370 Q 464 382 442 370"/>
          <path d="M 246 293 Q 210 257 195 209"/>
        </g>
          <g transform="rotate(-5 140 118)">
            <rect x="60" y="56" width="160" height="124" rx="20" fill="#d3ccf6"/>
            <path id="ring1" d="M 80.0,50.0 h 120 a 26,26 0 0,1 26,26 v 84 a 26,26 0 0,1 -26,26 h -120 a 26,26 0 0,1 -26,-26 v -84 a 26,26 0 0,1 26,-26 h 120 a 26,26 0 0,1 26,26 v 84 a 26,26 0 0,1 -26,26 h -120 a 26,26 0 0,1 -26,-26 v -84 a 26,26 0 0,1 26,-26 " fill="none"/>
            <text class="ring sym" fill="#5b4fc0"><textPath href="#ring1" startOffset="0%" data-text="#  " data-size="17">#  <animate attributeName="startOffset" from="0%" to="50%" dur="58s" repeatCount="indefinite"/></textPath></text>
          </g>
          <text class="stage-num" x="140" y="104" fill="#15121f" text-anchor="middle">1</text>
          <text class="stage-name" x="140" y="140" fill="#15121f" text-anchor="middle">{{ db.steps[0][lang].title }}</text>
          <g transform="rotate(-4 410 108)">
            <ellipse cx="410" cy="108" rx="88" ry="84" fill="#3a5a2a"/>
            <path id="ring2" d="M 318,108 a 92,88 0 1,1 184,0 a 92,88 0 1,1 -184,0 a 92,88 0 1,1 184,0 a 92,88 0 1,1 -184,0 " fill="none"/>
            <text class="ring" fill="#3a5a2a"><textPath href="#ring2" startOffset="0%" data-text="{{ db.steps[1][lang].ring }} ·">{{ db.steps[1][lang].ring }} ·<animate attributeName="startOffset" from="0%" to="50%" dur="66s" repeatCount="indefinite"/></textPath></text>
          </g>
          <text class="stage-num" x="410" y="94" fill="#ffffff" text-anchor="middle">2</text>
          <text class="stage-name" x="410" y="130" fill="#ffffff" text-anchor="middle">{{ db.steps[1][lang].title }}</text>
          <g transform="rotate(-7 690 112)">
            <ellipse cx="690" cy="112" rx="124" ry="86" fill="#5b4fc0"/>
            <path id="ring3" d="M 588,112 a 102,63 0 1,1 204,0 a 102,63 0 1,1 -204,0 a 102,63 0 1,1 204,0 a 102,63 0 1,1 -204,0 " fill="none"/>
            <text class="ring" fill="#e8f34a"><textPath href="#ring3" startOffset="0%" data-text="{{ db.steps[2][lang].ring }} ·">{{ db.steps[2][lang].ring }} ·<animate attributeName="startOffset" from="0%" to="50%" dur="74s" repeatCount="indefinite"/></textPath></text>
          </g>
          <text class="stage-num" x="690" y="98" fill="#ffffff" text-anchor="middle">3</text>
          <text class="stage-name" x="690" y="134" fill="#ffffff" text-anchor="middle">{{ db.steps[2][lang].title }}</text>
          <g transform="rotate(5 872 292)">
            <rect x="796" y="226" width="152" height="132" rx="26" fill="#e8452c"/>
            <path id="ring4" d="M 822.0,220.0 h 100 a 32,32 0 0,1 32,32 v 80 a 32,32 0 0,1 -32,32 h -100 a 32,32 0 0,1 -32,-32 v -80 a 32,32 0 0,1 32,-32 h 100 a 32,32 0 0,1 32,32 v 80 a 32,32 0 0,1 -32,32 h -100 a 32,32 0 0,1 -32,-32 v -80 a 32,32 0 0,1 32,-32 " fill="none"/>
            <text class="ring sym" fill="#c93a22"><textPath href="#ring4" startOffset="0%" data-text="@  " data-size="17">@  <animate attributeName="startOffset" from="0%" to="50%" dur="82s" repeatCount="indefinite"/></textPath></text>
          </g>
          <text class="stage-num" x="872" y="278" fill="#ffffff" text-anchor="middle">4</text>
          <text class="stage-name" x="872" y="314" fill="#ffffff" text-anchor="middle">{{ db.steps[3][lang].title }}</text>
          <g transform="rotate(6 610 372)">
            <ellipse cx="610" cy="372" rx="106" ry="72" fill="#a8bdb4"/>
            <path id="ring5" d="M 500,372 a 110,76 0 1,1 220,0 a 110,76 0 1,1 -220,0 a 110,76 0 1,1 220,0 a 110,76 0 1,1 -220,0 " fill="none"/>
            <text class="ring" fill="#5b4fc0"><textPath href="#ring5" startOffset="0%" data-text="{{ db.steps[4][lang].ring }} ·">{{ db.steps[4][lang].ring }} ·<animate attributeName="startOffset" from="0%" to="50%" dur="90s" repeatCount="indefinite"/></textPath></text>
          </g>
          <text class="stage-num" x="610" y="358" fill="#15121f" text-anchor="middle">5</text>
          <text class="stage-name" x="610" y="394" fill="#15121f" text-anchor="middle">{{ db.steps[4][lang].title }}</text>
          <g transform="rotate(-4 292 368)">
            <rect x="174" y="310" width="236" height="116" rx="58" fill="#15121f"/>
            <path id="ring6" d="M 232.0,304.0 h 120 a 64,64 0 0,1 64,64 v 0 a 64,64 0 0,1 -64,64 h -120 a 64,64 0 0,1 -64,-64 v 0 a 64,64 0 0,1 64,-64 h 120 a 64,64 0 0,1 64,64 v 0 a 64,64 0 0,1 -64,64 h -120 a 64,64 0 0,1 -64,-64 v 0 a 64,64 0 0,1 64,-64 " fill="none"/>
            <text class="ring sym" fill="#15121f"><textPath href="#ring6" startOffset="0%" data-text="&amp;  " data-size="17">&amp;  <animate attributeName="startOffset" from="0%" to="50%" dur="98s" repeatCount="indefinite"/></textPath></text>
          </g>
          <text class="stage-num" x="292" y="354" fill="#ffffff" text-anchor="middle">6</text>
          <text class="stage-name" x="292" y="390" fill="#ffffff" text-anchor="middle">{{ db.steps[5][lang].title }}</text>
        <g transform="rotate(3 470 246)">
          <rect x="402" y="202" width="136" height="88" fill="#e8f34a"/>
          {%- for line in t.centre %}
          <text class="centre" x="470" y="{{ 230 + loop.index0 * 21 }}" text-anchor="middle">{{ line }}</text>
          {%- endfor %}
        </g>
      </svg>
    </div>
  </header>
  <script>
    // Fit each ring of words exactly once around its shape, then let it travel slowly.
    (function () {
      var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function fit() {
        document.querySelectorAll('.process textPath').forEach(function (tp) {
          var path = document.querySelector(tp.getAttribute('href'));
          var anim = tp.querySelector('animate');
          var loop = path.getTotalLength() / 2, base = tp.dataset.text + (tp.dataset.size ? '' : ' '), best = 1, bestSize = 0, want = +(tp.dataset.size || 18);
          tp.textContent = base;
          tp.parentNode.style.fontSize = want + 'px';
          var one = tp.getComputedTextLength();
          if (!one) return; // this drawing is hidden at the current screen width
          for (var n = 1; n <= 80; n++) {
            var size = want * loop / (one * n);
            if (!bestSize || Math.abs(size - want) < Math.abs(bestSize - want)) { best = n; bestSize = size; }
          }
          tp.textContent = base.repeat(best);
          tp.parentNode.style.fontSize = bestSize.toFixed(2) + 'px';
          tp.setAttribute('textLength', loop.toFixed(1));
          if (anim && !still) tp.appendChild(anim);
        });
      }
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit); else fit();
      var timer; window.addEventListener('resize', function () { clearTimeout(timer); timer = setTimeout(fit, 200); });
    })();
  </script>
